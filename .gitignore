.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ML outputs
outputs/
*.pt
*.pth
runs/

!outputs/.gitkeep


# =========================
# Real data
# =========================

# Real-data raw archives are too large for Git
data/real/raw/
*.rar

# Incomplete downloads
*.part

# Keep the filtered, reproducible study-area subset
!data/real/quang_tri/
!data/real/quang_tri/*.csv
!data/real/quang_tri/*.json


# =========================
# Node.js / Next.js
# =========================

# Dependencies
node_modules/

# Next.js build/cache
.next/

# Static export generated by Next.js
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel local config
.vercel/

# Large raw/generated datasets - do not push to GitHub

data/real/craters/quang_tri/crater_centroids.geojson

data/real/craters/quang_tri/crater_polygons.geojson

data/real/craters/quang_tri/predictions.zip

data/real/geospatial/raw/

# Detailed field observations and serialized models stay local.
data/real/ai_evidence/items_found.json
outputs_ai/training_observations.json
outputs_ai/evaluation_arrays.npz
outputs_ai/spatial_splits.json
outputs_ai/*.joblib
